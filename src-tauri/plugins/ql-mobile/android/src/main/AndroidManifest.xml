<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- In-app updates: hand the downloaded APK to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Reminders on time: exact alarms (granted automatically to reminder apps on Android 13+). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <application>
        <!-- Home-screen widget: today's dailies and reminders (QlWidget.kt). -->
        <receiver
            android:name="com.questline.mobile.QlWidgetProvider"
            android:exported="false"
            android:label="@string/ql_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ql_widget_info" />
        </receiver>
        <service
            android:name="com.questline.mobile.QlWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <provider
            android:name="com.questline.mobile.QlFileProvider"
            android:authorities="${applicationId}.ql.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ql_file_paths" />
        </provider>
    </application>
</manifest>
