<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the widget list. Tapping it ticks the daily or reminder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ql_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/ql_row_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@null"
        android:src="@drawable/ql_check_off" />

    <TextView
        android:id="@+id/ql_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ql_w_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ql_row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:textColor="@color/ql_w_ink_soft"
        android:textSize="12sp" />
</LinearLayout>
