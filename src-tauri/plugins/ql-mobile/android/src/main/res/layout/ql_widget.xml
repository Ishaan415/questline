<?xml version="1.0" encoding="utf-8"?>
<!-- Questline home-screen widget: today's dailies and reminders. Drawn by QlWidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ql_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ql_widget_bg"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/ql_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ql_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ql_widget_today"
                android:textColor="@color/ql_w_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ql_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ql_widget_open_app"
                android:textColor="@color/ql_w_ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ql_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="@color/ql_w_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/ql_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/ql_add_bg"
            android:contentDescription="@string/ql_widget_add"
            android:scaleType="center"
            android:src="@drawable/ql_add" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/ql_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/ql_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/ql_widget_empty"
            android:textColor="@color/ql_w_ink_soft"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
