{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Questline",
  "version": "0.1.0",
  "identifier": "com.questline.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Questline",
        "width": 1320,
        "height": 840,
        "minWidth": 380,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "backgroundColor": "#EAF4E4"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Pixel-RPG planner",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
